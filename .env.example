# Postgres DB, shouldn't need to be changed
POSTGRES_DB=dona
POSTGRES_USER=dona
POSTGRES_PASSWORD=password
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://dona:password@localhost:5432/dona

# App ports
APP_PORT=3000
APP_INTERNAL_PORT=3000
PORT=3000

# Next.js development origins
NEXT_ALLOWED_DEV_ORIGINS=127.0.0.1,127.0.0.1:3000,127.0.0.1:9012,localhost:3000

# Config for survey redirects
DONOR_ID_INPUT_METHOD=automated # Options: automated, showid, manually
DONOR_SURVEY_ENABLED=false # Options: true, false
DEMO_MODE=true # Options: true, false
DEMO_SHOW_HAS_TOKEN_BUTTON=false # Show "I have received my token" button even in demo mode
UPLOAD_TEST_ENABLED=false # Enable data file testing before upload
TOKEN_REQUIRED=false # Require enrollment token before donation flow
ENABLED_DATA_SOURCES=FB,IG # Options: WhatsApp|WA, Facebook|FB, Instagram|IG, IMessage|IMSG
FEEDBACK_SURVEY_ENABLED=false # Options: true, false
DONOR_SURVEY_LINK=https://survey.mbp.tf.uni-bielefeld.de/index.php?r=survey/index&sid=453492
FEEDBACK_SURVEY_LINK=https://survey.mbp.tf.uni-bielefeld.de/index.php?r=survey/&sid=158878
PUBLIC_DATA_DONATION_ENABLED=true # Set true to collect Facebook/Instagram posts, comments, and reactions

# Language setup (supported: en,de,hy)
ENABLED_LANGUAGES=en,hy
DEFAULT_LANGUAGE=en
BROWSER_LANGUAGE_ENABLED=false # Use browser language when no locale cookie is set

# Donation eligibility criteria
NEXT_PUBLIC_MIN_MESSAGES_PER_CHAT=3
NEXT_PUBLIC_MIN_CHATS_FOR_DONATION=5
NEXT_PUBLIC_MIN_CONTACTS_PER_CHAT=2
NEXT_PUBLIC_MAX_FEEDBACK_CHATS=10
NEXT_PUBLIC_MIN_FEEDBACK_CHATS=3
NEXT_PUBLIC_DEFAULT_FEEDBACK_CHATS=5


# Duplicate donation check
NEXT_PUBLIC_DUPLICATE_DONATION_CHECK_ENABLED=false # Server-side check enabled
DUPLICATE_DONATION_CHECK_ENABLED=false # Client-side check enabled
NEXT_PUBLIC_MIN_MESSAGES_FOR_DUPLICATE_CHECK=10 # Minimum number of messages required to perform duplicate check
DUPLICATE_CHECK_EXCEPTION_HASHES_CSV_PATH=public/documents/sample-data/duplicate-check-exceptions.csv # Path to CSV file containing hashes of donations that should be excluded from duplicate check